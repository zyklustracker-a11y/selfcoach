rules_version = '2';

// Concept chapter 10: a user may only ever touch their own subtree.
//
// The concept sketches a single `/users/{userId}/{document=**}` rule. That cannot
// be used here: a recursive wildcard would also match /books and grant unvalidated
// writes, and rule results are OR-ed, so the permissive match would always win.
// Every collection therefore gets its own match. Collections not listed here are
// denied — they arrive with the phase that introduces them.
//
// Conditions check the type before the value everywhere, so a malformed write
// evaluates to false rather than raising an evaluation error.
service cloud.firestore {
  match /databases/{db}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /books/{bookId} {
        function isValidBook(d) {
          return d.title is string
            && d.title.size() > 0
            && d.title.size() <= 300
            && d.author is string
            && d.author.size() <= 300
            && d.status in ['planned', 'reading', 'finished', 'abandoned']
            && d.isActive is bool
            && d.tags is list
            && d.tags.size() <= 30
            && (d.isbn == null || (d.isbn is string && d.isbn.size() <= 40))
            && (d.coverUrl == null || (d.coverUrl is string && d.coverUrl.size() <= 2000))
            && (d.summaryEntryId == null
                || (d.summaryEntryId is string && d.summaryEntryId.size() <= 200));
        }

        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidBook(request.resource.data);
      }

      match /entries/{entryId} {
        function isFilledText(value, maxLength) {
          return value is string && value.size() > 0 && value.size() <= maxLength;
        }

        function isOptionalString(value, maxLength) {
          return value == null || (value is string && value.size() <= maxLength);
        }

        // Required fields depend on the type (CLAUDE.md 7.1a). An insight carries
        // the three-part chain; a book summary only the closing thought, because
        // the actions from that book already became entries of their own.
        function isValidEntry(d) {
          return d.type in ['insight', 'book_summary']
            && (d.type != 'insight' || (
                 isFilledText(d.learning, 5000)
              && isFilledText(d.meaning, 5000)
              && isFilledText(d.action, 5000)))
            && (d.type != 'book_summary' || (
                 isFilledText(d.summary, 5000)
              && isOptionalString(d.meaning, 5000)
              && isOptionalString(d.action, 5000)))
            && isOptionalString(d.bookId, 200)
            && isOptionalString(d.bookTitle, 300)
            && isOptionalString(d.quote, 5000)
            && (d.page == null || (d.page is int && d.page > 0 && d.page < 100000))
            && d.tags is list && d.tags.size() <= 30
            && d.keywords is list && d.keywords.size() <= 200
            && d.dayKey is string && d.dayKey.size() == 10
            && d.weekKey is string && d.weekKey.size() == 8;
        }

        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEntry(request.resource.data);
      }

      match /todos/{todoId} {
        function isValidTodo(d) {
          return d.title is string
            && d.title.size() > 0
            && d.title.size() <= 500
            && (d.notes == null || (d.notes is string && d.notes.size() <= 2000))
            && d.kind in ['daily', 'principle']
            && d.status in ['open', 'done', 'dropped']
            && (d.sourceEntryId == null || d.sourceEntryId is string)
            && (d.bookId == null || d.bookId is string)
            // A principle carries no due date; a daily one is a dayKey.
            && (d.dueDate == null || (d.dueDate is string && d.dueDate.size() == 10))
            && (d.kind != 'principle' || d.dueDate == null)
            && d.postponedCount is int
            && d.postponedCount >= 0;
        }

        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTodo(request.resource.data);
      }

      // The document id is the ISO week, so a week can only hold one review.
      match /reviews/{weekKey} {
        function isValidReview(d) {
          return d.weekKey == weekKey
            && d.weekKey is string
            && d.weekKey.size() == 8
            && d.questions is list
            && d.questions.size() <= 12
            && d.answers is list
            && d.answers.size() == d.questions.size()
            && d.topInsightIds is list
            && d.topInsightIds.size() <= 20
            && d.entryCount is int
            && d.todoDoneCount is int
            && d.todoTotalCount is int;
        }

        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidReview(request.resource.data);
      }
    }
  }
}
