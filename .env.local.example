# Copy to .env.local and fill in the values from the Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
#
# .env.local is git-ignored and must never be committed. The apiKey is not a secret
# — it ships inside every built bundle — but the project config still stays out of
# the repository.
#
# storageBucket is deliberately absent: the app uses no Cloud Storage, book covers
# are referenced as external URLs only (CLAUDE.md section 2).
#
# IMPORTANT — VITE_FIREBASE_AUTH_DOMAIN must be the domain the app is served from,
# not the readcoach-*.firebaseapp.com value the console suggests by default. Both
# are Firebase Hosting sites of the same project and both serve /__/auth/handler,
# but signInWithRedirect only survives Safari's tracking prevention when the app
# and the auth handler share one origin. Different origins turn the redirect into
# third-party storage access, which iOS blocks in standalone mode.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=readcoach-29227.web.app
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
