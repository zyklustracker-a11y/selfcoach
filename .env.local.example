# Copy to .env.local and fill in the values from the Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
#
# .env.local is git-ignored and must never be committed.
#
# storageBucket is deliberately absent: the app uses no Cloud Storage, book covers
# are referenced as external URLs only (CLAUDE.md section 2).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
